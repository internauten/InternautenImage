# PrestaShop-generated module config cache
config.xml
config_*.xml

# Local agent notes (credentials, admin URL)
AGENTS.local.md
CLAUDE.local.md

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python leftovers (from previous tooling)
__pycache__/
*.pyc

# Logs / temp
*.log
*.tmp
*.temp

# Packaged release artifacts
*.zip
!*.keep

# Optional dependency directories
vendor/
node_modules/
